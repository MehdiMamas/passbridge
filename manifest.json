{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.4.31",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "key": "",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "src/popup.html",
    "default_title": "__MSG_extensionName__"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "commands": {
    "fill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "__MSG_cmdFillLogin__"
    },
    "autofill-login": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "__MSG_cmdAutofillLogin__"
    },
    "lock-vault": {
      "description": "__MSG_cmdLockVault__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/passkey-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "src/passkey-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "permissions": [
    "nativeMessaging",
    "notifications",
    "activeTab",
    "alarms",
    "privacy",
    "storage",
    "contextMenus",
    "webRequest",
    "offscreen",
    "tabs",
    "webNavigation",
    "scripting",
    "clipboardWrite",
    "clipboardRead",
    "webAuthenticationProxy"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2", "overlay/*", "icons/icon48.png"],
      "matches": ["*://*/*"]
    }
  ]
}