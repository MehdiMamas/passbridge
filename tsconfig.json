{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "chrome"
    ],
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false
  },
  "include": [
    "src/background.js",
    "src/content.js",
    "src/apple/**/*.js",
    "src/ui/**/*.jsx",
    "src/ui/**/*.tsx"
  ]
}
