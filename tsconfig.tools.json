{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "ESNext.Array", "DOM"],
    "types": ["node", "chrome"],
    "noImplicitAny": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "scripts/**/*.ts",
    "test-harness/automation/**/*.ts",
    "test-harness/fake-apple-helper/**/*.ts"
  ]
}
